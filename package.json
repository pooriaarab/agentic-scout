{
  "name": "agentic-scout",
  "version": "0.1.0",
  "description": "Search Reddit, Hacker News via Algolia, and RSS feeds with a TypeScript SDK, CLI, and MCP server for thread ranking and content ideas.",
  "keywords": [
    "Reddit",
    "Hacker News",
    "Algolia",
    "rss",
    "thread-search",
    "content-discovery",
    "opportunity-scoring",
    "content-ideas",
    "TypeScript",
    "Node.js",
    "cli",
    "mcp",
    "fixtures"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-scout.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-scout",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-scout": "./dist/cli.js",
    "agentic-scout-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
